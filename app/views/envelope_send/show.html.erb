<h1 class="text-2xl font-bold mb-4">Choose Parties for <%= @envelope.name %></h1>

<p class="mb-4">
  <%= link_to 'Edit Document', edit_template_path(@envelope.template), class: 'btn btn-outline btn-sm' %>
</p>

<%= form_for :envelope, url: transaction_envelope_send_path(@transaction, @envelope), method: :post do %>
  <div class="space-y-2 mb-4">
    <% @candidate_parties.each do |party| %>
      <label class="flex items-center gap-2">
        <%= check_box_tag 'party_ids[]', party.id, true, id: "party_ids_#{party.id}" %>
        <%= party.display_name %> (<%= party.role.name %>)
      </label>
    <% end %>
  </div>

  <% if @prefillable_fields.present? %>
    <div class="form-control mb-4">
      <p class="font-bold mb-2">Fill In Before Sending</p>
      <div class="space-y-2">
        <% @prefillable_fields.each do |field| %>
          <div>
            <%= label_tag "envelope_prefill_values_#{field['uuid']}", field['name'] %>
            <%= text_field_tag "envelope[prefill_values][#{field['uuid']}]", nil,
                                id: "envelope_prefill_values_#{field['uuid']}", class: 'base-input' %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="form-control mb-4">
    <%= label_tag 'envelope_expire_at', 'Expires On (optional)' %>
    <%= date_field_tag 'envelope[expire_at]', nil, id: 'envelope_expire_at', class: 'base-input' %>
  </div>

  <div class="form-control mb-4">
    <p class="font-bold mb-2">Signing Order</p>
    <label class="flex items-center gap-2">
      <%= radio_button_tag 'envelope[signing_order]', 'sequential', @envelope.signing_order_sequential? %>
      Sequential (one party at a time)
    </label>
    <label class="flex items-center gap-2">
      <%= radio_button_tag 'envelope[signing_order]', 'parallel', @envelope.signing_order_parallel? %>
      Parallel (everyone at once)
    </label>
  </div>

  <%= submit_tag 'Send', class: 'btn btn-neutral' %>
<% end %>
